/// operune:secret@0.1.0 — SecretStore port 的 guest 侧契约（规范 §41.2 / §16.6）
///
/// §41.2 对 Config / State / Secret 三分离的明确定义中，Secret 是：
///
/// > Secret 是受专门访问控制与防泄漏规则保护的敏感值。
///
/// ## grant / read semantics（§41.2 MUST）
/// - 读取按 grant：安装实例被授予的 secret 名称集合（§17.3 "secret
///   names" 是 scope 维度之一），由 Runtime Policy 在激活时解析并持久
///   到 InstallationId（§17.1 两阶段含义：本 WIT import 只表达"程序
///   需要 secret 能力"，授权范围是 Runtime Grant）；
/// - 调用时仍做 enforcement（§17.5 第四层）：授权撤销、scope 变化、
///   policy 快照变化以确定语义生效，不依赖 Component 自觉；
/// - guest 只能读取被授予名称的当前值；本契约不存在任何写、轮换、
///   创建 secret 的入口（轮换是管理员/密钥提供方职责，§16.6）。
///
/// ## 防泄漏契约注释（§16.6，本契约与 Core 共同强制）
/// - secret 值**永不进入**日志、error context、panic report、metrics
///   label、audit event（§16.6 明文禁止）；本契约的所有错误变体与
///   元数据均不携带值（值只在 `read-secret` 的返回值出现一次）；
/// - 故意**不区分**"名称不存在"与"无权限"（`denied` 同时覆盖），
///   防止把本契约变成 secret 存在性预言机；
/// - guest 侧同等义务（契约期望，Core 无法代行）：secret 值不得
///   进入 guest 的日志/Display/Debug/Serialize；读取后尽快 zeroize
///   （§16.6 进程内暴露面要求，Core 侧 SecretStore 以 secrecy/zeroize
///   包装，本契约是跨边界接口面）；
/// - 值用 `list<u8>` 而非 string 表达：字节缓冲区可被 guest 按
///   §16.6 清理；字符串是不可控的泄漏载体（进入日志/Display 的
///   经典路径），契约层杜绝该形态。
///
/// ## 读取副作用
/// `read-secret` 是唯一有副作用的调用（读取本身产生审计事件，
/// §41.2 secret audit / §41.3 验收：读取、拒绝、轮换与审计必须可
/// 验证）；审计事件只含名称、版本、结果与安装实例，**不含值**。
///
/// ## SecretStore port（§16.6）
/// 独立 SecretStore port 与跨平台 key-provider（KEK 管理）是 Core 侧
/// Rust port 与 ADR 事项：普通 SQLite metadata 表不得保存明文 secret，
/// KEK 不得与密文同等保护级别存放在同一数据库。本契约是该 port 的
/// guest 可见面，不含任何存储实现细节。
///
/// ## 与 WASI 的关系（P4，论证见 wit/README.md §7）
/// WASI 0.2/0.3 不存在任何 secret/credential 管理接口（wasi:config 是
/// 配置不是凭据）；防泄漏规则与名称级 grant scope 是仅 Operune 平台
/// 拥有的语义（§6.6）。
///
/// ## 与 0.4 web 演进的关系（§21.4 / §42，不重复实现）
/// 本契约是 stateful substrate 的一部分：0.4 的 Web Application Runtime
/// 复用本契约的 secret 语义（如 bridge 的凭据边界继续成立，§21.3），
/// 不重造第二套 secret 系统；本 package 按自身版本独立演进（§6.6）。
package operune:secret@0.1.0;

/// SecretStore 的 guest 侧读取服务（Component import）。
interface secret {
    /// secret 名称（record wrapper，§13.5；非裸 string）。
    ///
    /// 不变量：非空；仅含 `[A-Za-z0-9._-]`；长度受 Core 宿主侧上限
    /// 约束。名称是 grant scope 的键（§17.3），不是 secret 值的一部分。
    record secret-name {
        value: string,
    }

    /// secret 版本（轮换检测，record wrapper，§13.5）。
    ///
    /// 每次轮换递增。供长驻 guest 检测"当前持有的值已过时"后重新
    /// 读取；版本号本身不敏感，但审计关联仍记录它（§41.2 audit）。
    record secret-version {
        value: u64,
    }

    /// secret 值：敏感字节，绝不进入日志/错误/Display（§16.6）。
    ///
    /// 见本文件顶部"防泄漏契约注释"：guest 必须 zeroize、不得
    /// Serialize/Debug/Display/log；值是平台不透明字节，平台永不
    /// 解析或回显。
    record secret-value {
        data: list<u8>,
    }

    /// 已授予 secret 的元数据（列表项；不含值）。
    record secret-metadata {
        name: secret-name,
        version: secret-version,
    }

    /// secret 读取的预期失败（§6.3）。
    enum secret-error {
        /// 无权限或名称不存在——有意合并，不泄露存在性
        /// （见本文件顶部防泄漏契约）。
        denied,
        /// 名称违反本契约不变量（见 `secret-name`）。
        /// 不泄露存在性（仅表达调用者自身构造错误）。
        invalid-name,
        /// 密钥提供方/存储不可用（重试性）。
        unavailable,
        /// 存储的 secret 未通过完整性检查（损坏）。
        /// 需管理员介入（轮换）；平台不会返回损坏值。
        corrupt,
        /// 超出预算：读取速率/体积/次数（§7.4 宿主侧上限）。
        over-budget,
        /// guest/host 内部不可恢复错误。
        internal,
    }

    /// 读取被授予名称的 secret 当前值。
    ///
    /// - 名称必须在安装实例的 grant scope 内（§17.3/§17.5），
    ///   否则 `denied`；
    /// - 返回值为本契约中 secret 值出现的唯一位置；
    /// - 读取产生审计事件（名称、版本、结果，无值，§41.2 audit）；
    /// - 无缓存保证：每次读取返回当前值（轮换后下次读取即新值）。
    read-secret: func(name: secret-name) -> result<secret-value, secret-error>;

    /// 列举安装实例被授予的全部 secret 名称与版本（不含值）。
    ///
    /// 只返回 grant scope 内的名称；用于启动时枚举与轮换检测，
    /// 不构成存在性查询（grant 之外的名字不可见）。
    list-granted-secrets: func() -> result<list<secret-metadata>, secret-error>;
}
