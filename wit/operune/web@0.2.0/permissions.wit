package operune:web@0.2.0;

// operune:web@0.2.0 — 0.4.0 Web Application Runtime：page / action
// permission declarations（§42.2）
//
// 权限**声明面**：Component 声明它可要求的命名权限集合（permission
// declarations），页面与路由通过 required-permission 引用；enforcement
// 在 Core（见下）。
//
// ## 强制执行点（Core 侧；本契约只提供声明面）
// - 页面请求：Core-mediated bridge 在服务端重新执行 authentication →
//   RBAC → grant → page permission 检查（§17.5 四层授权链 / §21.3），
//   未授权以确定 HTTP 语义拒绝（403 等），不进 guest 错误空间；
// - route 调用：同一授权链上的 action permission 检查（route-declaration
//   的 required-permission；0.1.0 actions 注释预留的"按 action 绑定授权"
//   在此落地，§43 的 scoped capability policy 是其 0.5 细化）；
// - permission-name 是组件作用域的命名引用；到 grant scope 的映射与
//   求值策略是 Core 政策（0.4.0 声明面 + Core 强制执行点，§42.2）。
//
// ## 凭据边界
// 本 interface 只有命名引用（字符串等价比较），不含任何凭据 / 会话 /
// 角色字段；认证信息永远不会被转发进请求结构（继承 §21.3 凭据边界）。

interface permissions {
    /// 权限名：Component 声明的、页面 / 路由可引用的权限标识符。
    ///
    /// record wrapper（§13.5）：Core 只做等价比较、声明校验与审计，不
    /// 解析语义；引用了未声明的 permission-name 的声明视为非法
    /// （invalid-permission）。
    record permission-name {
        value: string,
    }

    /// 权限声明：可被页面 / 路由引用的命名权限。
    record permission-declaration {
        /// 权限名（同一 app descriptor 内唯一）。
        name: permission-name,
        /// 可选人类可读描述（审计与 UI 展示；Core 不解析）。
        description: option<string>,
    }
}
