package operune:web@0.2.0;

// operune:web@0.2.0 — 0.4.0 Web Application Runtime：typed route / action
// registration（§42.2）
//
// 本 interface 是 typed backend route / action registration 的**声明面**：
// Component 在 app descriptor 中声明路由（route-id / HTTP 方法 / 路径
// 模板 / 参数类型 / 权限引用）。注册发生在声明期（安装 / 激活校验阶段），
// 不是运行期动态注册：确定性、可审计，冲突在声明期检出（conflict
// diagnostics，见 app-descriptor-error）。
//
// ## route namespace（Core 分配、不可冲突）
// 0.1.0 的 mount namespace（Core 分配、不可冲突，§21.3）在 0.4.0 扩展为
// route namespace：route-id 在 mount namespace 下由 Core 登记，同一
// ComponentVersion 内 route-id 必须唯一、路径模板（方法 + 规范化模板）
// 必须唯一；声明冲突（route-id-conflict / page-id-conflict / path-conflict）
// 在 descriptor 校验阶段以确定性诊断拒绝。
//
// ## typed action（§42.2；兑现 0.1.0 注释承诺）
// 0.1.0 actions 注释明文承诺："0.4.0 的 typed action 将提供结构化参数"。
// 本版本兑现：route 声明携带参数类型闭集（param-type），Core 在分发前按
// 声明校验并构造参数（typed-param / param-value，见 route-dispatch）；
// 运行期入口是 `route-dispatch.handle-route`。0.1.0 的 action-payload
// 过渡边界保留给未声明路由的无类型 action（`actions` interface，语义
// 继承 0.1）。
//
// ## 与 wasi:http 的关系（§6.6 论证见 wit/README.md §11）
// 路由是 Component 声明的、Core 托管的**平台注册表**，不是网络端点：
// §21.3 明文禁止组件自行 bind 监听端口；请求经 Core-mediated bridge
// 到达（frame / channel 与 InstallationId + ComponentVersion 绑定，
// 服务端重执行 auth / RBAC / grant / permission / body / deadline /
// rate / concurrency 检查）。wasi:http 的 incoming-handler 没有"宿主
// 托管、绑定安装身份、受平台策略治理的路由注册与冲突诊断"语义。

interface routes {
    use permissions.{permission-name};

    /// route 标识符：Component 定义的开放路由 / typed action 标识符。
    ///
    /// 是 0.1.0 `action-name`（actions interface）的 typed 演进：0.4.0
    /// 的 typed action 以 route-id 为分发键；两个命名空间在运行期共存
    /// （已声明路由 → route-dispatch，未声明 action → actions.handle-action，
    /// 0.1 语义继承）。Core 只做等价比较与审计记录，不解析语义。
    record route-id {
        value: string,
    }

    /// 路径模板：挂载命名空间下的路由路径，可含模板参数段。
    ///
    /// 语法：以 "/" 开头的规范化相对路径；段可为字面段或模板段
    /// "{name}"，name 为小写字母 / 数字 / "-" 组成的标识符；同一路径
    /// 内模板段不得重复。不变量（Core 校验）：不含 ".." 段、空段、
    /// 反斜杠；不得解析到挂载命名空间之外；非法模板返回
    /// invalid-path-template。
    record path-template {
        value: string,
    }

    /// 可声明的 HTTP 方法闭集。
    ///
    /// HEAD 与 OPTIONS 不可声明：Core 在 bridge 层自动处理（HEAD 按
    /// GET 语义去掉响应体、OPTIONS 按 CORS 预检语义），与声明无关；
    /// CONNECT / TRACE 等一律不支持（浏览器安全政策与 §21.3 隔离底线）。
    enum http-method {
        get,
        post,
        put,
        patch,
        delete,
    }

    /// 结构化参数类型闭集（typed action 的参数声明形态，§42.2）。
    ///
    /// 闭集在 WIT 中固定，不随组件声明扩展（§22.4 精神：禁止把任意
    /// 动态值当作万能 payload；本契约以固定类型闭集表达 typed 参数）。
    /// 0.1.0 的 action-payload 仍是 json / raw 两种形态，本闭集是其
    /// 结构化补充（route-dispatch.param-value 与其一一对应）。
    enum param-type {
        /// 文本（UTF-8 字符串）。
        text,
        /// 有符号 64 位整数。
        integer,
        /// 无符号 64 位整数。
        unsigned,
        /// 布尔值。
        boolean,
        /// 64 位浮点（JSON 数字的常规形态）。
        decimal,
    }

    /// 单个声明参数：名称 + 类型。
    ///
    /// 本版本的 typed 参数全部为必填；可选数据走 route-request 的
    /// payload（见 route-dispatch）。名称必须与路径模板段一致（或作为
    /// 查询参数名），不一致 → param-mismatch。
    record route-param {
        /// 参数名（路径模板段名或查询参数名）。
        name: string,
        /// 声明类型（Core 按此校验分发时的 param-value）。
        value-type: param-type,
    }

    /// 路由声明：一个 typed backend route / action。
    record route-declaration {
        /// route 标识符（分发键；route namespace 内唯一）。
        route-id: route-id,
        /// HTTP 方法。
        method: http-method,
        /// 路径模板。
        path: path-template,
        /// 参数声明（与路径模板一致；不一致 → param-mismatch）。
        params: list<route-param>,
        /// 调用该 route 所需的权限声明引用（可选；Core 强制执行）。
        required-permission: option<permission-name>,
    }
}
