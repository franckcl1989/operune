package operune:web@0.2.0;

// operune:web@0.2.0 — 0.4.0 Web Application Runtime：bounded backend
// actions（§42.2）
//
// 本 interface 是 0.1.0 `actions` 的**版本内全量定义**：全部类型形态与
// 行为语义继承 0.1.0（§21.3），0.4.0 不推翻；typed action 的演进面在
// `route-dispatch` interface（route-id + 结构化参数，兑现 0.1.0 注释
// 承诺："0.4.0 的 typed action 将提供结构化参数"，§42.2）。
//
// ## 边界（继承 0.1.0，无条件 baseline，§42.2）
// - 只有 bounded request / response：无 WebSocket、无任意长连接、无流、
//   无 stream / realtime。native stream / future / async 只在 §8.3
//   WASI 0.3 production Gate 通过后、以新 interface 版本沿标准路径
//   顺延加入（§42.3），本版本契约不含任何 stream / future / async 面；
// - action 是无状态一次调用：0.1.0 stateless contract 不承诺跨调用
//   instance affinity（§7.3），guest 不得假设 linear memory / 实例
//   局部变量在下次调用仍存在。
//
// ## cancellation / disconnect 语义（Core 执行，§42.2 无条件 baseline）
// - 每次调用有 Core 施加的 deadline（§7.4 / §7.5 预算语义）；客户端
//   disconnect 或超时后，Core 可中止（epoch interruption）in-flight
//   guest 调用并丢弃结果；
// - guest 不得假设"调用返回 = 客户端已收到"：响应交付不保证（request
//   cancellation / disconnect semantics）；已提交的副作用不自动回滚，
//   需要原子性的写路径使用 operune:state 事务（§20.5）；
// - 本版本没有 guest 侧 cancellation token / 长调用面（p2 同步调用
//   形态）；native cancellation 随 stream / future 面在 Gate 通过后
//   演进（§42.3）。
//
// ## Core-mediated（继承 0.1.0；Core 执行语义，本契约设计不得与之冲突）
// Core 将 frame / channel 与 InstallationId + ComponentVersion 绑定，并
// 在服务端重新执行 authentication、RBAC、grant、action permission、
// body / deadline / rate / concurrency 检查（§21.3）。per-Component
// HTTP quotas / backpressure（§42.2）同样在 bridge 层执行：超配额以
// 确定 HTTP 语义拒绝（429 / 503），不进 guest 错误空间，guest 侧无
// 背压回调面（polling / realtime 形态顺延，§42.3）。InstallationId
// 是 Core 侧事实（§19.4），不出现在本契约的任何参数中。
//
// ## 凭据边界（继承 0.1.0）
// 浏览器内 Component 代码不接触 Root Admin session bearer 或 CSRF
// secret（§16.5 / §21.3）。因此请求结构没有任何会话、cookie、CSRF、
// 认证凭据字段；Core 的认证信息永远不会转发进 action-request /
// route-request。
//
// ## 原子版本（§21.5）
// backend action export 与 web assets、app descriptor 属于同一
// ComponentVersion；升级通过 active snapshot 一次性切换，任何新 action
// 调用解析到同一 active version，禁止前后端版本拼接。

interface actions {
    /// action 名称：Component 定义的开放动作标识符（形态与语义继承
    /// 0.1.0，如 "run-check"）。
    ///
    /// record wrapper（§13.5）：Core 只做等价比较与审计记录，不解析
    /// 语义。0.4.0 已声明路由的 action 使用 route-id（route-dispatch）；
    /// 本类型保留给未声明路由的无类型 action（0.1 兼容路径），两个
    /// 命名空间在运行期共存。
    record action-name {
        value: string,
    }

    /// action 载荷的互斥形态（variant 表达互斥的不同形态，§6.3；语义
    /// 继承 0.1.0）。
    ///
    /// 0.1.0 注释明文：本 variant 是过渡边界，不得作为未来动态值的
    /// 后门。0.4.0 的结构化参数由 route-dispatch 的 param-value 提供
    /// （闭集类型，见 routes.wit）；本 variant 保留给未声明路由的
    /// action 与 route 的辅助载荷。
    variant action-payload {
        /// JSON 文本载荷（UI 表单 / 交互的常规形态）。
        json(string),
        /// 原始字节载荷。
        raw(list<u8>),
    }

    /// 有界 action 请求（形态与语义继承 0.1.0；§21.3 bounded request）。
    ///
    /// 不变量：载荷体积受 Core 宿主侧硬上限约束（body 上限，§21.3 /
    /// §7.4）；结构中没有凭据、会话或 CSRF 字段（见本文件顶部
    /// "凭据边界"）。
    record action-request {
        action: action-name,
        payload: action-payload,
    }

    /// action 的预期失败（guest 返回值空间；错误闭集继承 0.1.0）。
    enum action-error {
        /// 请求的 action 名称不存在。
        not-found,
        /// 载荷不符合该 action 的预期形态或契约不变量。
        invalid-payload,
        /// guest 内部不可恢复错误。
        internal,
    }

    /// 处理一次有界 backend action 调用（语义继承 0.1.0）。
    ///
    /// - 同步返回：一次调用对应一次完整 response，无流、无增量、
    ///   无长连接（§21.3）；
    /// - 响应体积受 Core 宿主侧硬上限约束；
    /// - Core 侧拒绝（未授权、超时、超预算、限流、quota 超限）不进入
    ///   本返回值空间，由 bridge 以确定语义在 HTTP 层表达（§21.3）；
    /// - 无状态：不承诺跨调用 instance affinity（§7.3）；
    /// - cancellation / disconnect 语义见本文件顶部。
    handle-action: func(request: action-request) -> result<list<u8>, action-error>;
}
