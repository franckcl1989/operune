package operune:event@0.1.0;

// operune:event@0.1.0 — 参考 world（作者侧便利，非运行时事实源）
//
// 使用 event bus 的 Component 在 0.1.0 需要与 operune:event 相关的
// 契约总览：导入 event（发布），导出 handler（接收投递；订阅集合
// 是 policy 事实，见 event.wit 顶部）。
// Core 的兼容判断只依赖二进制中真实可观察的 contract surface（§6.7），
// 不依赖 root world 名称。
//
// 完整 stateful Component 还导出 operune:component/descriptor@0.1.0 及
// 按需的其它 operune 契约；各 package 的参考 world 可组合。

/// 使用 Operune event bus 的 Component 参考 world。
world operune-event-component {
    import event;
    export handler;
}
