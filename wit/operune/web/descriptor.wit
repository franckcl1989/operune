/// operune:web@0.1.0 — 最小 Component Web bridge：web descriptor（§21.3）
///
/// Component 通过导出本 interface 声明自己携带 Web UI
/// （内嵌静态资产 + 可选 bounded backend action）。
///
/// ## 与 operune:component/descriptor 的关系
/// - operune:component/descriptor 是安装 / 身份契约，任何 Component 都必须导出；
/// - operune:web/descriptor 是 Web 能力声明，只有携带 Web UI 的 Component 导出；
/// - 两者都属于同一 ComponentVersion，随版本原子切换（§21.5）。
///
/// ## 挂载点语义（§21.3，Core 执行）
/// - mount namespace 由 Core 分配且不可冲突；本契约中的路径一律是 Component
///   内部的资产逻辑路径（如 "/index.html"），不是宿主文件路径，也不是挂载 URL；
///   Core 负责把内部资产路径映射到其分配的挂载命名空间；
/// - 作者不得声明、猜测或要求特定挂载路径。
///
/// ## §21.3 强制浏览器隔离底线（Core 执行语义；WIT 设计不得与之冲突）
/// - Component UI 运行在 Core 创建的 sandboxed frame / 等价独立 browser
///   security context 中；不得获得 parent DOM、Root Admin cookie / storage
///   或同源 API 权限；
/// - Core 生成并强制 restrictive CSP；Component 不能放宽 sandbox、CSP、frame、
///   navigation、popup、download、form、network connect 等安全策略；
/// - UI 到 backend action 只能经过 Core-mediated bridge；
/// - Component 响应不得设置或覆盖 Set-Cookie / CORS / CSP / 认证 /
///   代理转发等 Core-owned security headers。
/// 因此本契约及 operune:web/actions 中不存在任何会话凭据、cookie、CSRF 字段。
package operune:web@0.1.0;

interface descriptor {
    /// Component 内嵌资产的逻辑路径（record wrapper，§13.5；非宿主文件路径）。
    ///
    /// 不变量：值必须是规范化相对路径，以 "/" 开头，不含 ".." 段、空段或
    /// 反斜杠；不得解析到挂载命名空间之外。Core 对每个路径执行规范化与
    /// 越界校验（防 path traversal，§32 security test 覆盖）。
    record asset-path {
        value: string,
    }

    /// 可组合的 Web 能力声明（flags 表达可组合特征，§6.3）。
    ///
    /// Core 的兼容判断仍以二进制可观察 contract surface 为准（§6.7）；
    /// 本声明用于 UI 展示与交叉校验：作者声明与二进制可观察 exports
    /// 不一致时视为 contract violation。
    flags web-features {
        /// Component 携带可通过 operune:web/assets 读取的内嵌静态资产。
        static-assets,
        /// Component 提供 bounded backend action（operune:web/actions）。
        backend-actions,
    }

    /// web descriptor：Component 声明自己携带 Web UI。
    record web-descriptor {
        /// Web UI 的入口资产路径（例如 "/index.html"）。
        /// Core 将其解析到分配好的挂载命名空间；缺失或越界视为非法。
        entry: asset-path,
        /// 本 Component 提供的 Web 能力集合。
        features: web-features,
        /// 挂载命名空间下的展示名（可选，作者声明）。
        display-name: option<string>,
    }

    /// web descriptor 阶段的预期失败（WIT result 表达预期失败，§6.3）。
    ///
    /// trap、超时、超预算由 Core 在宿主侧观察，不进入返回值空间。
    enum web-descriptor-error {
        /// 返回的 metadata 无法解析或违反契约不变量（入口路径非法等）。
        malformed,
        /// 未来演进：平台不再支持该 web descriptor contract 版本。
        unsupported-contract-version,
        /// guest 内部不可恢复错误。
        internal,
    }

    /// 读取 web descriptor。
    ///
    /// 与 operune:component/descriptor 相同的契约约束（§19.3 的精神，
    /// Core 执行）：side-effect-free、bounded、可重复；不依赖当前时间、
    /// 随机数、外部网络或宿主可变文件；同一 ContentDigest + 同一
    /// contract version 返回同一 canonical web descriptor。
    get-web-descriptor: func() -> result<web-descriptor, web-descriptor-error>;
}
